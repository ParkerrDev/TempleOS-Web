//PLACETHEBLOCKSOFTHETEMPLE
#define MAN_START_X1$ID,2$$ID,-2$
#define MAN_START_Y 10
#define MAP_SCALE 8
#define PLOT_GRID_WIDTH 24
#define PLOT_GRID_HEIGHT 24
#defineSCRN_SCALE 512
//#define MAN_HEIGHT 125
#define MICRO_STEPS 4
#define LOS_SCALE4

I64 map_width,map_height,wordc=0,nextWordTimer;
U8 *map=NULL,*map2=NULL,
**wwords=NULL,*word=NULL,
*panels_processed_bitmap=NULL,
*panels_processed_bitmap2=NULL;

I64 man_xx,man_yy,MAN_HEIGHT=125;
F64 man_é;
Bool engine_on=FALSE;
F64 t0,tf;

class Keys
{
 Bool left,right,up,down;
};

Keys keys;


U0 SongTask(I64)
{//Randomly generate (by God :-)
