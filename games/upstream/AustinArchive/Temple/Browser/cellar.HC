  }

}

U0 CFTransform(CDC *dc,I64 *x,I64 *y,I64 *z)
{
  I64 zz;
  Mat4x4MulXYZ(dc->r,x,y,z);
  zz=SCRN_SCALE/3+*z;
  if (zz<1) zz=1;
  *x=SCRN_SCALE/2* *x/zz;
  *y=SCRN_SCALE/2* (*y+MAN_HEIGHT)/zz;
  *x+=dc->x;
  *y+=dc->y;
  *z+=dc->z;
}

Bool LOSPlot(U8 *,I64 x, I64 y, I64)
{
$ID,2$$ID,-2$  if (!map[(y/LOS_SCALE)*map_width+(x/LOS_SCALE)])
    return FALSE;
  else
    return TRUE;
}


Bool LOS(I64 x1,I64 y1,I64 x2,I64 y2)
{//Line of sight
  return Line(NULL,x1*LOS_SCALE/SCRN_SCALE,y1*LOS_SCALE/SCRN_SCALE,0,
	x2*LOS_SCALE/SCRN_SCALE,y2*LOS_SCALE/SCRN_SCALE,0,&LOSPlot);
}

public I64 GodTempleInit(U8 *file="C:/Home/Games/AustinArchive/Temple/Vocab.DD")
{//Read God's vocab file for picking words.
  I64 i,ch;
  U8 *buf,*ptr,*ptr2;
  //CDirEntry *tmpde,*tmpde1;
  i=0;
  if(buf=ptr=FileRead(file))
  {
   while(*ptr){
     while(*ptr && !Bt(char_bmp_word,*ptr))
      ptr++;
     if(*ptr)
     {
      while(*ptr &&Bt(char_bmp_word,*ptr))
        ptr++;
      i++;
     }
   }
   Free(buf);
  } 
  wordc=i;
  wwords=MAlloc(wordc*sizeof(U8 *));
  i=0;


  if (buf=ptr=FileRead(file)) {
      while (*ptr) {
	while (*ptr && !Bt(char_bmp_word,*ptr))
	  ptr++;
	if (*ptr) {
	  ptr2=ptr;
	  while (*ptr && Bt(char_bmp_word,*ptr))
	    ptr++;
	  ch=*ptr;
	  *ptr=0;
	  wwords[i]=StrNew(ptr2);
          i++;
	  *ptr=ch;
	}
      }
      Free(buf);
    }
  nextWordTimer=50;
  return wordc;
}

U0 Init()
{
 I64 i,x,y;
 CDC*dc;
 QueInit(&keys);
 DocClear;
 "$$$ER$BG,LTBLUE$$%h*c",TEXT_ROWS/2,'\n';
 
 dc=Sprite2DC($IB,"<2>",BI=2$);
 map_width=dc->width/MAP_SCALE+2;
 map_height=dc->height/MAP_SCALE+2;
 Free(map);
 Free(panels_processed_bitmap);
 map=CAlloc(map_width*map_height*sizeof(U8));
 panels_processed_bitmap=MAlloc((map_width*map_height+7)>>3);
 for(y=0;y<map_height-2;y++)
 {
  for(x=0;x<map_width-2;x++)
  {
    map[(map_height-2-y)*map_width+x+1]= GrPeek(dc,x*MAP_SCALE,y*MAP_SCALE);
  }
 }
 DCDel(dc);
 man_xx=(1+MAN_START_X)*SCRN_SCALE;
 man_yy=(map_height-1-MAN_START_Y)*SCRN_SCALE;
 man_é=0;
 t0=tS;
 tf=0;
}

//not efficent, allocate for second map layer
U0 SecondInit()
{
 I64 i,x,y;
 CDC*dc;
 QueInit(&keys);
 DocClear;
 "$$$ER$BG,LTBLUE$$%h*c",TEXT_ROWS/2,'\n';
 
 dc=Sprite2DC($IB,"<4>",BI=4$);
 map_width=dc->width/MAP_SCALE+2;
 map_height=dc->height/MAP_SCALE+2;
 Free(map2);
 Free(panels_processed_bitmap2);
 map2=CAlloc(map_width*map_height*sizeof(U8));
 panels_processed_bitmap=MAlloc((map_width*map_height+7)>>3);
 for(y=0;y<map_height-2;y++)
 {
  for(x=0;x<map_width-2;x++)
  {
    map2[(map_height-2-y)*map_width+x+1]= GrPeek(dc,x*MAP_SCALE,y*MAP_SCALE);
  }
 }
}

I64 RandRng(I64 min,I64 max)
{
 return min+(Rand() * (max-min-1));
}

U0 FetchWord()
{
 I64 i;
 I64 godWord= RandRng(0,wordc);

 word=wwords[godWord];
 if(word==NULL)
  throw('Dumpling');


}

U0 MoveMan(F64 é)
{
  I64 x,y,color,step=SCRN_SCALE/2;

  x=man_xx+step*Cos(é);
  y=man_yy-step*Sin(é);
  x=Clamp(x,0,map_width*SCRN_SCALE);
  y=Clamp(y,0,map_height*SCRN_SCALE);
  color=map[y/SCRN_SCALE*map_width+x/SCRN_SCALE];
  if(color==DKGRAY||color==RED)
  { 
   if(color==RED){
     MAN_HEIGHT=925;
     engine_on=TRUE;
   } 
   else{
     MAN_HEIGHT=125;
     engine_on=FALSE;
   }
   man_xx=x;
   man_yy=y;
  }
    
}

U0 RotateMan(F64 d)
{
  I64 i;
  for(i=0;i<MICRO_STEPS;i++){
   man_é+=d/MICRO_STEPS;
   Sleep(15);
  }  
}

U0GrChar(CDC*dc=gr.dc,U8 ch,I64 x,I64 y,I64 scale)
{
  I64 i,j,k=0;
  for(i=0;i<FONT_HEIGHT;i++){
    for(j=0;j<FONT_WIDTH;j++){
      if(Bt(&text.font[ch],k++)){
        GrRect(dc,x+j*scale,y+i*scale,scale,scale);
      }
    }
  }
}

U0 DrawIt(CTask *task,CDC *dc)
{
 I64 i,j,c,c2,x,y,wordI,*s2w,//indexes
  x1h,y1h,x1w,y1w,//measurements
  *objpos,*seapos,*stairpos,*arcpos,
  *bowlpos,*colpos,x1,y1,z1,//object positions
  *cow1,*cow2,*cow3,*cow4,//object positions
  xh,yh,zh,//heuristic xyz
  xx,yy,zz,//light source
  *cowdirectionspawn,
  cx=task->pix_width/2,
  cy=task->pix_height/2;
  F64 tt;
  CD3I32 poly[4];
 
  DCDepthBufAlloc(dc);
  MemSet(panels_processed_bitmap,0,(map_width*map_height+7)>>3);
  MemSet(panels_processed_bitmap2,0,(map_width*map_height+7)>>3);
 
  Mat4x4RotZ(dc->r,man_é+ã/2);
  Mat4x4RotX(dc->r,ã/2);
  DCMat4x4Set(dc,dc->r);

  xh=-man_xx/SCRN_SCALE;
  yh=-man_yy/SCRN_SCALE;
  zh=0;
  Mat4x4MulXYZ(dc->r,&xh,&yh,&zh);
  Mat4x4TranslationEqu(dc->r,xh,yh,zh);
  
  //Screen to world
  s2w=Mat4x4IdentNew(task);
  Mat4x4RotX(s2w,-ã/2);
  Mat4x4RotZ(s2w,-man_é-ã/2);
  xh=0;yh=0;wordI=0;zh=SCRN_SCALE;
  Mat4x4MulXYZ(s2w,&xh,&yh,&zh);

  //Rotate lights
  xx=dc->ls.x;yy=dc->ls.y;zz=-dc->ls.z;
  (*dc->transform)(dc,&xx,&yy,&zz);
  dc->ls.x=xx;dc->ls.y=yy;dc->ls.z=zz;
  
  dc->flags|=DCF_TRANSFORMATION;
  dc->transform=&CFTransform;
  dc->x=cx;
  dc->y=cy;
 //brick config 
  objpos=Mat4x4IdentNew(task);
  Mat4x4RotX(objpos,-ã/2);
  Mat4x4Scale(objpos,MAP_SCALE);
  
//gword
  //wordpos=Mat4x4IdentNew(task);
  //Mat4x4RotX(wordpos,-ã/2);
  //Mat4x4Scale(wordpos,MAP_SCALE);
  
//brazen sea config
  seapos=Mat4x4IdentNew(task);
  Mat4x4RotX(seapos,-ã/2);
  Mat4x4Scale(seapos,4);

  cow1=Mat4x4IdentNew(task);
  Mat4x4RotX(cow1,-ã/2);
  Mat4x4Scale(cow1,2);

  cow2=Mat4x4IdentNew(task);
  Mat4x4RotX(cow2,-ã/2);
  Mat4x4RotZ(cow2,-ã/2);
  Mat4x4Scale(cow2,2);
  cow3=Mat4x4IdentNew(task);
  Mat4x4RotX(cow3,-ã/2);
  Mat4x4RotZ(cow3,ã/2);
  Mat4x4Scale(cow3,2);
  cow4=Mat4x4IdentNew(task);
  Mat4x4RotX(cow4,-ã/2);
  Mat4x4RotZ(cow4,ã);
  Mat4x4Scale(cow4,2);
//stair east pos
  stairpos=Mat4x4IdentNew(task);
  Mat4x4RotX(stairpos,-ã/2);
  Mat4x4RotZ(stairpos,-ã/2);
  Mat4x4Scale(stairpos,3);
//waterbowl pos
  bowlpos=Mat4x4IdentNew(task);
  Mat4x4RotX(bowlpos,-ã/2);
  //Mat4x4RotZ(stairpos,-ã/2);
  Mat4x4Scale(bowlpos,1);    
//columns pos
  colpos=Mat4x4IdentNew(task);
  Mat4x4RotX(colpos,-ã/2);
  //Mat4x4RotZ(colpos,-ã/2);
  Mat4x4Scale(colpos,2);
//arcpos
  arcpos=Mat4x4IdentNew(task);
  Mat4x4RotX(arcpos,-ã/2);
  Mat4x4RotZ(arcpos,-ã/2);
  Mat4x4Scale(arcpos,1);


  

  //draw the world as a grid respective to LOS
  Seed(1);
  x1h=man_xx+yh*PLOT_GRID_WIDTH/2+xh*(PLOT_GRID_HEIGHT-1);
  y1h=man_yy-xh*PLOT_GRID_WIDTH/2+yh*(PLOT_GRID_HEIGHT-1);
  xh>>=1; yh>>=1;
  for (j=0;j<PLOT_GRID_HEIGHT*2;j++) 
  {
    x1w=x1h;
    y1w=y1h;
    for (i=0;i<PLOT_GRID_WIDTH*4;i++) 
    {
      xx=x1w/SCRN_SCALE; yy=y1w/SCRN_SCALE;
      x=xx*SCRN_SCALE-man_xx; y=yy*SCRN_SCALE-man_yy;
      if (1<=xx<map_width-1 && 1<=yy<map_height-1 &&
	    !LBts(panels_processed_bitmap,yy*map_width+xx)) 
      {
        if ((c=map2[yy*map_width+xx]) &&
	      LOS(xx*SCRN_SCALE+SCRN_SCALE/2,yy*SCRN_SCALE+SCRN_SCALE/2,
	      man_xx,man_yy)) 
        {
	  if(c==YELLOW)//2nd Z only reads Bricks
          {
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=0;
           DCTransform(dc,&x1,&y1,&z1);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,900,$IB,"<1>",BI=1$,objpos);
          }
        }
	if ((c=map[yy*map_width+xx]) &&
	      LOS(xx*SCRN_SCALE+SCRN_SCALE/2,yy*SCRN_SCALE+SCRN_SCALE/2,
	      man_xx,man_yy)) 
        {
         if(c==PURPLE||c==YELLOW||c==WHITE)//1st Layer Z
          dc->color=LTGRAY;
         else
         {
          if(c==BROWN||BLUE||GREEN)
           dc->color=DKGRAY;
          else
           dc->color=c;
         }
         poly[0].x=x;
         poly[0].y=y;
         poly[0].z=0;
         poly[1].x=x+SCRN_SCALE;
         poly[1].y=y;
         poly[1].z=0;
         poly[2].x=x+SCRN_SCALE;
         poly[2].y=y+SCRN_SCALE;
         poly[2].z=0;
         poly[3].x=x;
         poly[3].y=y+SCRN_SCALE;
         poly[3].z=0;
        GrFillPoly3(dc,4,poly);

         if(c==WHITE)//gword
         {
          x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=0;
           DCTransform(dc,&x1,&y1,&z1);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,0,$IB,"<9>",BI=9$,colpos);
           Sprite3Mat4x4B(dc,150+x+SCRN_SCALE/2,y+SCRN_SCALE/2,100,$IB,"<10>",BI=10$,arcpos);
           Sprite3Mat4x4B(dc,150+x+SCRN_SCALE/2,-150+y+SCRN_SCALE/2,100,$IB,"<11>",BI=11$,arcpos);
          
           //x1=x+SCRN_SCALE/2;
           //y1=y+SCRN_SCALE/2;
           //z1=0;
           //DCTransform(dc,&x1,&y1,&z1);
           try{while(word[wordI]!='@'&&word[wordI]!='('&&word[wordI]!=' '){
             //dc->color=DKGRAY;
             //GrRect(dc,0,0,300,300); 
             dc->color=WHITE;
             GrChar(dc,word[wordI],(wordI*42),SCRN_SCALE/2,5);
             wordI++;}
           }catch{}
           if(nextWordTimer==0)
           {
             FetchWord;
             nextWordTimer=100;
           }
         
           nextWordTimer--;
         }
         
        //cows
         if(c==GREEN)
         {
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           cowdirectionspawn=RandRng(0,4);
           DCTransform(dc,&x1,&y1,&z1);
           switch(cowdirectionspawn)
           {
            case 0:
            Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow1);
               break;
            case 1:
                Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow2);
               break;
            case 2:
                Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow3);
               break;
            case 3:
               Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow4);
               break;
           }
          
          
         }
         if(c==BLUE)
         {
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=0;
           DCTransform(dc,&x1,&y1,&z1);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,0,$IB,"<5>",BI=5$,bowlpos);
          
         }
         if(c==YELLOW)//Bricks
          {
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=0;
           DCTransform(dc,&x1,&y1,&z1);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,100,$IB,"<1>",BI=1$,objpos);
          }
         if(c==BROWN)//columns
         {
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=0;
           DCTransform(dc,&x1,&y1,&z1);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,300,$IB,"<7>",BI=7$,colpos);
          
         }
         
          if(c==PURPLE)//Brazen Sea
          {
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=10;
           DCTransform(dc,&x1,&y1,&z1);
           //cow1 and sea//face south
           Mat4x4TranslationEqu(cow1,0,400,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,700,$IB,"<5>",BI=5$,seapos);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow1);
           //cow2
           Mat4x4TranslationEqu(cow1,150,400,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow1);
           //cow3
           Mat4x4TranslationEqu(cow1,-150,400,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow1);
           //cow4 //cows facing west
           Mat4x4TranslationEqu(cow2,400,-150,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow2);
           //cow 5
           Mat4x4TranslationEqu(cow2,400,0,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow2);
           //cow 6
           Mat4x4TranslationEqu(cow2,400,150,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow2);
           //cow7 //cows facing east
           Mat4x4TranslationEqu(cow3,-400,-150,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow3);
           //cow8
           Mat4x4TranslationEqu(cow3,-400,0,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow3);
           //cow9
           Mat4x4TranslationEqu(cow3,-400,150,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow3);
           //cow10 //cows facing south
           Mat4x4TranslationEqu(cow4,150,-400,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow4);
           //cow11
           Mat4x4TranslationEqu(cow4,0,-400,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow4);
           //cow12
           Mat4x4TranslationEqu(cow4,-150,-400,0);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2,200,$IB,"<6>",BI=6$,cow4);
       
          }
          if(c==RED)//altar stairs
          { 
           x1=x+SCRN_SCALE/2;
           y1=y+SCRN_SCALE/2;
           z1=0;
           DCTransform(dc,&x1,&y1,&z1);
           Sprite3Mat4x4B(dc,x+SCRN_SCALE/2,y-350+SCRN_SCALE/2,00,$IB,"<3>",BI=3$,stairpos);
            

           //fire
           if (engine_on) {
            for (i=0;i<60;i++) {
             if ((i^winmgr.updates)&1)
	      dc->color=YELLOW;
             else
	      dc->color=RED;
             GrLine(dc,i+SCRN_SCALE/2,SCRN_SCALE-100,(i*5)+SCRN_SCALE/2,(i*2)+y+SCRN_SCALE/2);
             GrLine(dc,-i+SCRN_SCALE/2,SCRN_SCALE-100,(-i*3)+SCRN_SCALE/2,(i*2)+y+SCRN_SCALE/2);
             dc->color=BROWN;
             GrRect(dc,100,400,400,50);
            }

            for (i=0;i<10;i++) {
              switch (RandU16&3) {
	       case 0: dc->color=WHITE;	break;
	       case 1: dc->color=LTGRAY;	break;
	       case 2: dc->color=DKGRAY;	break;
	       case 3: dc->color=BLACK;	break;
              }
              GrPlot(dc,x+SCRN_SCALE/2,y+SCRN_SCALE/2);//cy-(y+RandU16%12-6));
            }
            Snd(22);
            }
          }
//Four Walls
          if (!map[(yy+1)*map_width+xx]) {
	    dc->color=LTGRAY;
	    poly[0].x=x;
	    poly[0].y=y+SCRN_SCALE;
	    poly[0].z=0;
	    poly[1].x=x+SCRN_SCALE;
	    poly[1].y=y+SCRN_SCALE;
	    poly[1].z=0;
	    poly[2].x=x+SCRN_SCALE;
	    poly[2].y=y+SCRN_SCALE;
	    poly[2].z=SCRN_SCALE;
	    poly[3].x=x;
	    poly[3].y=y+SCRN_SCALE;
	    poly[3].z=SCRN_SCALE;
	    GrFillPoly3(dc,4,poly);
	  }
	  if (!map[yy*map_width+xx+1]) {
	    dc->color=LTGRAY;
	    poly[0].x=x+SCRN_SCALE;
	    poly[0].y=y;
	    poly[0].z=0;
	    poly[1].x=x+SCRN_SCALE;
	    poly[1].y=y+SCRN_SCALE;
	    poly[1].z=0;
	    poly[2].x=x+SCRN_SCALE;
	    poly[2].y=y+SCRN_SCALE;
	    poly[2].z=SCRN_SCALE;
	    poly[3].x=x+SCRN_SCALE;
	    poly[3].y=y;
	    poly[3].z=SCRN_SCALE;
	    GrFillPoly3(dc,4,poly);
	  }
	  if (!map[(yy-1)*map_width+xx]) {
	    dc->color=LTGRAY;
	    poly[0].x=x;
	    poly[0].y=y;
	    poly[0].z=0;
	    poly[1].x=x+SCRN_SCALE;
	    poly[1].y=y;
	    poly[1].z=0;
	    poly[2].x=x+SCRN_SCALE;
	    poly[2].y=y;
	    poly[2].z=SCRN_SCALE;
	    poly[3].x=x;
	    poly[3].y=y;
	    poly[3].z=SCRN_SCALE;
	    GrFillPoly3(dc,4,poly);
	  }
	  if (!map[yy*map_width+xx-1]) {
	    dc->color=LTGRAY;
	    poly[0].x=x;
	    poly[0].y=y;
	    poly[0].z=0;
	    poly[1].x=x;
	    poly[1].y=y+SCRN_SCALE;
	    poly[1].z=0;
	    poly[2].x=x;
	    poly[2].y=y+SCRN_SCALE;
	    poly[2].z=SCRN_SCALE;
	    poly[3].x=x;
	    poly[3].y=y;
	    poly[3].z=SCRN_SCALE;
	    GrFillPoly3(dc,4,poly);
	   }
        }
      }
      x1w-=yh;
      y1w+=xh; 
    }
    x1h-=xh;
    y1h-=yh;
  }



  
  //Draw Map heads-up display, scaled 2 pixs
  //Free(dc->r);
  DCMat4x4Set(dc,Mat4x4IdentNew(task));
  dc->x=task->pix_width -2*map_width;
  dc->y=task->pix_height-2*map_height;
  dc->z=0;
  dc->transform=&DCTransform;
  dc->thick=2;
  for (i=0;i<map_height;i++)
    for (j=0;j<map_width;j++) {
      dc->color=map[(map_height-1-i)*map_width+j];
      GrPlot3(dc,2*j,2*i,0);
    }

    //Draw Things on heads-up Map
  dc->color=LTCYAN;
  GrPlot3(dc,2*(man_xx/SCRN_SCALE),2*(map_height-1-man_yy/SCRN_SCALE),0);

  if (tf) {
    dc->color=LTRED;
    tt=tf;
  } else {
    dc->color=LTGREEN;
    GrLine(dc,cx-5,cy,cx+5,cy);
    GrLine(dc,cx,cy-5,cx,cy+5);
    tt=tS;
  }
  
  Free(s2w);
  Free(objpos);
  Free(seapos);
  Seed(0);
 // Free(r1);
 // Free(r2);
 // Free(r3);

//Sprite3ZB(dc,300,300,0,$IB,"<1>",BI=1$,tS);
  if(keys.left)
  {
    Spawn(&RotateMan,(-ã/32)(I64));
    keys.left=FALSE;
  }
  if(keys.right)
  {
    Spawn(&RotateMan,(ã/32)(I64));
    keys.right=FALSE;
  }
  if(keys.up)
  {
    MoveMan(man_é);
    keys.up=FALSE;
  }
  if(keys.down)
  {
    MoveMan(man_é+ã);
    keys.down=FALSE;
  }
  //word = MStrPrint("%s",GodWordStr);
  //Free(word);
  //GrPrint(dc,300,FONT_HEIGHT,"%s",word);
 //&QueInit(keys);
}


U0 CleanUp()
{
  Free(map);
  Free(map2);
  Free(panels_processed_bitmap2);
  Free(panels_processed_bitmap);
  map=NULL;
  map2=NULL;
  panels_processed_bitmap2=NULL;
  panels_processed_bitmap=NULL;
}


U0Main()
{
  I64 arg1,arg2;
  CDC *dc=DCAlias;
  SettingsPush;
  WinMax;
  DocCursor;
 DocClear;
  SecondInit;
  GodTempleInit;if(wwords==NULL)throw('File404');
  FetchWord;
  Init;
  Fs->draw_it=&DrawIt;
  Fs->song_task=Spawn(&SongTask,NULL,"Song",,Fs);
  try{
    while(TRUE) {
         
      switch(GetMsg(&arg1,&arg2,1<<MSG_KEY_DOWN+1<<MSG_KEY_UP))
      {
        case MSG_KEY_UP:
          case 0:
          switch(arg2.u8[0])
          {
            case SC_CURSOR_LEFT:
             keys.left=TRUE;
             break;
            case SC_CURSOR_RIGHT:
             keys.right=TRUE;
             break;
            case SC_CURSOR_UP:
             keys.up=TRUE;
             break;
            caseSC_CURSOR_DOWN:
             keys.down=TRUE;
             break;
          }
          break;
        case MSG_KEY_DOWN:
          switch(arg1)
          {
           case CH_ESC:
           case CH_SHIFT_ESC:
            goto fs_done;
            break;
           case 0:
            switch(arg2.u8[0])
            {
              case SC_CURSOR_LEFT:
               keys.left=TRUE;
               break;
              case SC_CURSOR_RIGHT:
               keys.right=TRUE;
               break;
              case SC_CURSOR_UP:
               keys.up=TRUE;
               break;
              case SC_CURSOR_DOWN:
               keys.down=TRUE;
               break;
            }
            break;
          }
          break;
        case '\n':
          SecondInit;
          Init;
          break;
      }
    }
  fs_done:
  }
  catch{
  
   PutExcept;
   DocClear;
   SettingsPop;
   MenuPop;
   GetChar;
   CleanUp;
   DCDel(dc);
  }
}

Main;








