{
  "name": "templeos-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "sh tools/Test.sh",
    "test:browser": "node tools/browser/shell.mjs",
    "test:engine": "node tools/browser/engine.mjs",
    "test:snapshot": "node tools/browser/snapshot.mjs",
    "test:clip": "node tools/clip/mp4.mjs && node tools/clip/mkv.mjs && node tools/clip/browser.mjs",
    "build:bible": "node tools/bible-build.mjs",
    "serve": "node server.mjs",
    "test:chat": "node tools/browser/chat.mjs",
    "test:search": "node search/Query.test.mjs && node search/QueryMemory.test.mjs && node tools/browser/search.mjs",
    "test:lighthouse": "node tools/lighthouse/check.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.6.0",
    "playwright-core": "1.58.2"
  }
}
