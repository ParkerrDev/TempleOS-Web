# COEP: credentialless - the best of both worlds:
#  * SharedArrayBuffer works: the four guest cores share one WebAssembly.Memory, and the HolyC
#    editor runs blocking programs in a worker with a shared framebuffer + Atomics input,
#  * cross-origin <video>/<img> still load (Terry Search streams archive.org originals
#    inline; their download nodes send no CORS/CORP, which require-corp would block -
#    credentialless allows no-cors media, just sent without credentials).
# Safari doesn't support credentialless: it ignores it -> not isolated -> the OS runs on one
# core and the editor's runner shows its own warning; everything else works.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Engine, compiler and static program artifacts must match the current sources.
/hemu/*
  Cache-Control: no-cache
/Apps/Editor/*
  Cache-Control: no-cache
/build/*
  Cache-Control: no-cache

# The chat's service worker sits in its window's folder and answers for the
# page at the root (it shows the chat's notifications), so it may take that scope.
/Apps/Chat/ChatSw.js
  Service-Worker-Allowed: /
