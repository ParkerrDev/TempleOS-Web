U64 divide_record[11];
U8 divide_stack[4096];

asm {
DIVIDE_ENTRY::
  MOV U64 [R15],RSP
  MOV U64 8[R15],RAX
  MOV U64 16[R15],RDX
  MOV U64 24[R15],RCX
  PUSHFD
  POP U64 32[R15]
  MOV RAX,U64 [RSP]
  MOV U64 40[R15],RAX
  MOV RAX,U64 8[RSP]
  MOV U64 48[R15],RAX
  MOV RAX,U64 16[RSP]
  MOV U64 56[R15],RAX
  MOV RAX,U64 24[RSP]
  MOV U64 64[R15],RAX
  MOV RAX,U64 32[RSP]
  MOV U64 72[R15],RAX
  MOV RAX,U64 80[R15]
  MOV U64 [RSP],RAX
  MOV RAX,U64 8[R15]
  IRET

_DIVIDE_RUN::
  PUSH RBP
  MOV RBP,RSP
  PUSH R15
  PUSH R14
  PUSH R12
  PUSH RCX
  PUSH RDX
  PUSHFD
  MOV R15,SF_ARG1[RBP]
  MOV R14,RSP
  MOV R12,SF_ARG3[RBP]
  MOV RAX,SF_ARG4[RBP]
  MOV RDX,SF_ARG5[RBP]
  MOV RCX,SF_ARG6[RBP]
  MOV RSP,SF_ARG2[RBP]
  PUSH U64 SF_ARG7[RBP]
  POPFD
  CALL R12
  MOV RSP,R14
  POPFD
  POP RDX
  POP RCX
  POP R12
  POP R14
  POP R15
  POP RBP
  RET1 56
}

_extern _DIVIDE_RUN U0 DivideRun(U64 *record,U8 *sp,U8 *code,
      U64 a,U64 d,U64 divisor,U64 flags);
